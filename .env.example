# Run commands from the repository root. Local development only: auth is not implemented.
APP_ENV=development
POSTGRES_DB=ecus
POSTGRES_USER=ecus
POSTGRES_PASSWORD=ecus_local
DATABASE_PORT=55434
DATABASE_URL=postgresql+asyncpg://ecus:ecus_local@127.0.0.1:55434/ecus
COMPOSE_DATABASE_URL=postgresql+asyncpg://ecus:ecus_local@db:5432/ecus
WEB_PORT=5173
WEB_CONTAINER_PORT=8080
API_PROXY_TARGET=http://127.0.0.1:8000
VITE_API_BASE_URL=
VITE_DEFAULT_LOCALE=vi
STORAGE_ROOT=.data/files
JOBS_CONCURRENCY=2
JOBS_MAX_PENDING=4
JOBS_TIMEOUT_SECONDS=180
PROCESSING_TIMEOUT_SECONDS=1800
EXTRACTION_FIELD_BATCH_SIZE=40
EXTRACTION_PAGE_BATCH_SIZE=8
OCR_ENABLED=true
OCR_COMMAND=tesseract
OCR_LANGUAGES=eng+vie
OCR_DPI=200
OCR_MIN_CONFIDENCE=0.65
OCR_MAX_PIXELS=20000000
OCR_TIMEOUT_SECONDS=60
# No paid AI request is made at startup or during tests.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_EXTRACTION_MODEL=
AI_HS_MODEL=
# Empty reuses AI_EXTRACTION_MODEL. One request covers all differing fields.
AI_RECONCILIATION_MODEL=
RECONCILIATION_PROMPT_VERSION=v2
RECONCILIATION_REFERENCE_PATH=reference-data/semantic-references.v1.json
RECONCILIATION_MAX_FIELDS=200
RECONCILIATION_CONTEXT_CHARS=160
AI_SUPPORTS_VISION=true
AI_OUTPUT_MODE=json_schema
AI_TIMEOUT_SECONDS=60
AI_MAX_INPUT_CHARS=100000
AI_MAX_IMAGE_BYTES=5000000
AI_MAX_IMAGES=16
AI_PROMPT_VERSION=v1
EXTRACTION_FIELD_CATALOG_PATH=reference-data/ai-field-catalog.v1.json
REVIEW_SET_PROMPT_VERSION=v3
REVIEW_SOURCE_PROMPT_VERSION=v3
# Enable only when the configured provider supports image input.
EXTRACTION_USE_PAGE_IMAGES=false
EXTRACTION_IMAGE_DPI=120
EXTRACTION_IMAGE_JPEG_QUALITY=85
# Private request/response artifacts; authorization headers are never recorded.
AI_TRACE_ENABLED=false
# Default location is an ai-traces directory beside STORAGE_ROOT.
AI_TRACE_ROOT=

# Bounded manual PDF review / Excel export
REVIEW_MAX_FILE_BYTES=20000000
REVIEW_MAX_PDF_PAGES=100
REVIEW_MAX_DOCUMENTS=30
REVIEW_MAX_OBSERVATIONS=5000

# Optional authenticated review gateway; generated credentials stay in .data/.
REVIEW_GATEWAY_PORT=5180
REVIEW_AUTH_USERNAME=review
REVIEW_AUTH_FILE=.data/client-review/htpasswd
REVIEW_ACCESS_FILE=.data/client-review/access.json
REVIEW_PUBLIC_URL=
